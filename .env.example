# Salin file ini jadi .env lalu isi sesuai kebutuhan lokal kamu.

# Harus cocok dengan docker-compose.yml
DATABASE_URL="mysql://sdk_user:sdk_password@localhost:3306/sdk_gaharu_sempana"

# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string-yang-panjang"
NEXTAUTH_URL="http://localhost:3000"
